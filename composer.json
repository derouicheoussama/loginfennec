{
	"name": "derouicheoussama/infinity-loginshield",
	"description": "Infinity LoginShield – Login Customizer & Security for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/derouicheoussama/infinity-loginshield",
	"authors": [
		{
			"name": "Derouiche Oussama",
			"homepage": "https://www.derouicheoussama.com"
		}
	],
	"keywords": [ "wordpress", "login", "customizer", "security" ],
	"require": {
		"php": ">=7.2"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:syntax": "find . -name '*.php' -not -path './.git/*' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"lint:standards": "phpcs"
	}
}
